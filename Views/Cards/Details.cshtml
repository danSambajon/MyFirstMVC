@model MyFirstMVC.Models.Cards

@{
    ViewData["Title"] = "Details";
}

<div class="row">
    <div class="col-12">
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

<div class="card p-3 mt-3">
    <table class="table">
        <tr>
            <td>
                <b>@Html.DisplayNameFor(model => model.Question)</b>
            </td>
            <td>
                @Html.DisplayFor(model => model.Question)
            </td>
        </tr>
        <tr>
            <td>
                <b>@Html.DisplayNameFor(model => model.Answer)</b>
            </td>
            <td>
                @Html.DisplayFor(model => model.Answer)
            </td>
        </tr>
    </table>
    <div class="row mt-3 justify-content-end">
        <div class="col-auto">
            <div class="form-group">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-group">
                <a class="btn btn-outline-primary" asp-action="Index">Back</a>
            </div>
        </div>
    </div>
</div>